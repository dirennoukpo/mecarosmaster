# =============================================================================
# Dockerfile.base — IMAGE ROBOT (mecarosmaster)
# Présent sur le robot physique UNIQUEMENT (Raspberry Pi / YAHBOOM ROSMASTER)
# Architecture cible : linux/arm64
# =============================================================================

ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base AS base

# Re-déclarer les ARG après chaque FROM (scope Docker)
ARG ROS_DISTRO=humble
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Variables d'environnement système & ROS2
# Ces valeurs sont les DÉFAUTS IMAGE — elles sont toutes surchargeables
# via les fichiers .env du docker-compose (voir env/.env et env/.env.robot)
# ---------------------------------------------------------------------------
ENV ROS_DISTRO=${ROS_DISTRO} \
    PYTHONUNBUFFERED=1 \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig \
    # ── FastDDS ─────────────────────────────────────────────────────────────
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_base.xml \
    # ── Colcon ──────────────────────────────────────────────────────────────
    COLCON_HOME=/mecarosmaster_ws/.colcon \
    # ── Robot — frames TF (surchargées dans .env.robot si besoin) ───────────
    ROBOT_NAME=mecarosmaster \
    BASE_FRAME=base_link \
    ODOM_FRAME=odom \
    MAP_FRAME=map \
    # ── ROS2 réseau (surchargées dans .env commun) ───────────────────────────
    ROS_DOMAIN_ID=0 \
    ROS_LOCALHOST_ONLY=0

# ---------------------------------------------------------------------------
# Dépendances système de base + FastDDS
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # ── Build tools ─────────────────────────────────────────────────────────
    build-essential \
    cmake \
    git \
    pkg-config \
    ninja-build \
    # ── Python ──────────────────────────────────────────────────────────────
    python3-dev \
    python3-pip \
    python3-colcon-common-extensions \
    python3-colcon-mixin \
    python3-rosdep \
    python3-vcstool \
    python3-argcomplete \
    # ── Réseau & utilitaires ─────────────────────────────────────────────────
    wget \
    curl \
    ca-certificates \
    net-tools \
    iputils-ping \
    iproute2 \
    # ── USB / Série / Hardware (robot physique) ──────────────────────────────
    usbutils \
    udev \
    libusb-1.0-0-dev \
    picocom \
    python3-serial \
    socat \
    # ── Libs diverses ────────────────────────────────────────────────────────
    libjpeg-dev \
    nlohmann-json3-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# FastDDS — Middleware ROS2 (robot)
# rmw_fastrtps_cpp : implémentation C++ performante
# rosidl_typesupport : génération de code DDS pour les messages ROS2
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
    ros-${ROS_DISTRO}-fastrtps \
    ros-${ROS_DISTRO}-fastcdr \
    ros-${ROS_DISTRO}-rosidl-typesupport-fastrtps-cpp \
    ros-${ROS_DISTRO}-rosidl-typesupport-fastrtps-c \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Core & messages (commun robot/workstation)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclcpp-components \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-std-srvs \
    ros-${ROS_DISTRO}-trajectory-msgs \
    ros-${ROS_DISTRO}-diagnostic-msgs \
    ros-${ROS_DISTRO}-visualization-msgs \
    ros-${ROS_DISTRO}-action-msgs \
    ros-${ROS_DISTRO}-builtin-interfaces \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — TF (commun robot/workstation)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-tf2 \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    ros-${ROS_DISTRO}-tf2-msgs \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Build system & ament (commun robot/workstation)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-ament-cmake \
    ros-${ROS_DISTRO}-ament-cmake-python \
    ros-${ROS_DISTRO}-rosidl-default-generators \
    ros-${ROS_DISTRO}-rosidl-default-runtime \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Robot (ROBOT PHYSIQUE UNIQUEMENT)
# Noeuds : /robot_state_publisher  /joint_state_publisher
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Control hardware (ROBOT PHYSIQUE UNIQUEMENT)
# Noeuds : driver_node, controller_manager, hardware interface
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-hardware-interface \
    ros-${ROS_DISTRO}-composition \
    ros-${ROS_DISTRO}-rclcpp-lifecycle \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — IMU embarqué (ROBOT PHYSIQUE UNIQUEMENT)
# Noeud : /imu_filter_madgwick
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-imu-tools \
    ros-${ROS_DISTRO}-imu-filter-madgwick \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — LiDAR RPLidar (ROBOT PHYSIQUE UNIQUEMENT)
# Noeud : /rplidar_node
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rplidar-ros \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Caméra embarquée robot (ROBOT PHYSIQUE UNIQUEMENT)
# Noeud : /camera/camera (v4l2 ou realsense en embarqué)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-v4l2-camera \
    ros-${ROS_DISTRO}-camera-info-manager \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-image-transport-plugins \
    ros-${ROS_DISTRO}-compressed-image-transport \
    ros-${ROS_DISTRO}-camera-calibration-parsers \
    ros-${ROS_DISTRO}-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Odométrie & localisation embarquée (ROBOT PHYSIQUE UNIQUEMENT)
# Noeuds : /ekf_filter_node  /simple_fusion_odom
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-nav2-msgs \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS2 — Outils diagnostics & lifecycle (ROBOT PHYSIQUE UNIQUEMENT)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-lifecycle \
    ros-${ROS_DISTRO}-rqt-robot-monitor \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Configuration FastDDS (profil XML base robot)
# ---------------------------------------------------------------------------
RUN mkdir -p /etc/fastdds
COPY docker/config/fastdds_base.xml /etc/fastdds/fastdds_base.xml

# ---------------------------------------------------------------------------
# rosdep init + update
# ---------------------------------------------------------------------------
RUN rosdep init 2>/dev/null || true && rosdep update --rosdistro ${ROS_DISTRO}

# ---------------------------------------------------------------------------
# Création de l'utilisateur rosdev (non-root, jamais root en runtime)
# ---------------------------------------------------------------------------
RUN groupadd -g ${GROUP_ID} rosdev && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash rosdev && \
    usermod -aG dialout rosdev && \
    usermod -aG plugdev rosdev

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
RUN mkdir -p /mecarosmaster_ws && \
    chown -R ${USER_ID}:${GROUP_ID} /mecarosmaster_ws

COPY mecarosmaster_ws/src /mecarosmaster_ws/src

WORKDIR /mecarosmaster_ws

RUN bash -c "\
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    if [ \"\$(find src -name 'package.xml' | wc -l)\" -gt 0 ]; then \
        apt-get update && \
        rosdep install --from-paths src --ignore-src -r -y && \
        colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release; \
    else \
        echo '[INFO] Aucun package ROS2 trouvé — build ignoré.'; \
    fi && \
    rm -rf /var/lib/apt/lists/* build log /root/.ros"

# ---------------------------------------------------------------------------
# Sourcing bashrc — root (debug) & rosdev (runtime)
# Les variables critiques sont répétées ici pour les sessions interactives
# (docker exec, ssh) car les .env ne sont chargées qu'au démarrage du service
# ---------------------------------------------------------------------------
RUN printf '%s\n' \
    "source /opt/ros/${ROS_DISTRO}/setup.bash" \
    "[ -f /mecarosmaster_ws/install/setup.bash ] && source /mecarosmaster_ws/install/setup.bash" \
    "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" \
    "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_base.xml" \
    >> /root/.bashrc

RUN printf '%s\n' \
    "source /opt/ros/${ROS_DISTRO}/setup.bash" \
    "[ -f /mecarosmaster_ws/install/setup.bash ] && source /mecarosmaster_ws/install/setup.bash" \
    "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" \
    "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_base.xml" \
    >> /home/rosdev/.bashrc

# ---------------------------------------------------------------------------
# Droits finaux workspace
# ---------------------------------------------------------------------------
RUN chown -R ${USER_ID}:${GROUP_ID} /mecarosmaster_ws

COPY docker/entrypoints/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ✅ Basculer vers rosdev — jamais root en runtime
USER rosdev

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
