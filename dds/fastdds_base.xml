<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     fastdds_base.xml — Profil FastDDS pour le ROBOT (mecarosmaster)
     Compatible ROS2 / FastDDS
     ============================================================================= -->

<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <!-- =========================
         TRANSPORT UDPv4
         ========================= -->
    <transport_descriptors>

        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>

            <!-- Buffers optimisés Raspberry Pi -->
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>4194304</receiveBufferSize>

            <!-- Évite le blocage des publications -->
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>

    </transport_descriptors>

    <!-- =========================
         PARTICIPANT ROS2
         ========================= -->
    <participant
        profile_name="mecarosmaster_robot_participant"
        is_default_profile="true">

        <rtps>

            <!-- Nom DDS -->
            <name>mecarosmaster_robot</name>

            <!-- Désactive transports builtin -->
            <useBuiltinTransports>false</useBuiltinTransports>

            <!-- Utilise uniquement UDPv4 -->
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>

            <!-- =========================
                 DISCOVERY
                 ========================= -->
            <builtin>

                <discovery_config>

                    <!-- Discovery classique ROS2 -->
                    <discoveryProtocol>SIMPLE</discoveryProtocol>

                    <!-- Endpoint discovery -->
                    <m_simpleEDP>

                        <use_Publication_WriterANDSubscription_Reader>
                            true
                        </use_Publication_WriterANDSubscription_Reader>

                        <use_Publication_ReaderANDSubscription_Writer>
                            true
                        </use_Publication_ReaderANDSubscription_Writer>

                    </m_simpleEDP>

                    <!-- Heartbeat DDS -->
                    <leaseDuration>
                        <sec>20</sec>
                        <nanosec>0</nanosec>
                    </leaseDuration>

                    <leaseAnnouncement>
                        <sec>3</sec>
                        <nanosec>0</nanosec>
                    </leaseAnnouncement>

                </discovery_config>

            </builtin>

            <!-- Buffers sockets -->
            <sendSocketBufferSize>1048576</sendSocketBufferSize>
            <listenSocketBufferSize>4194304</listenSocketBufferSize>

        </rtps>

    </participant>

</profiles>