<?xml version="1.0"?>
<robot name="mecarosmaster" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="serial_port" default="/dev/myserial" />
  <xacro:arg name="car_type" default="1" />

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.32 0.28 0.08" />
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.32 0.28 0.08" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_fl">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.02" />
      </geometry>
    </visual>
  </link>
  <link name="wheel_fr">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.02" />
      </geometry>
    </visual>
  </link>
  <link name="wheel_rl">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.02" />
      </geometry>
    </visual>
  </link>
  <link name="wheel_rr">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.02" />
      </geometry>
    </visual>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_fl" />
    <origin xyz="0.14 0.12 0.0" rpy="0 1.5708 0" />
    <axis xyz="0 0 1" />
  </joint>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_fr" />
    <origin xyz="0.14 -0.12 0.0" rpy="0 1.5708 0" />
    <axis xyz="0 0 1" />
  </joint>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_rl" />
    <origin xyz="-0.14 0.12 0.0" rpy="0 1.5708 0" />
    <axis xyz="0 0 1" />
  </joint>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link" />
    <child link="wheel_rr" />
    <origin xyz="-0.14 -0.12 0.0" rpy="0 1.5708 0" />
    <axis xyz="0 0 1" />
  </joint>

  <xacro:include filename="$(find mecarosmaster_control)/urdf/ros2_control.xacro" />
</robot>
