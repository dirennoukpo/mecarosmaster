# =============================================================================
# env/.env — Variables d'environnement COMMUNES (robot + workstation)
# Chargé par docker-compose via env_file
# Les valeurs ici surchargent les ENV du Dockerfile.
# Les valeurs spécifiques machine sont dans .env.mecarosmaster / .env.workstation
# =============================================================================

# ── ROS2 ─────────────────────────────────────────────────────────────────────
ROS_DISTRO=humble

# Domaine DDS partagé entre le robot et la workstation (0–232)
# Tous les participants du même domaine se voient sur le LAN
ROS_DOMAIN_ID=0

# 0 = communication réseau autorisée (robot ↔ workstation)
# 1 = communication localhost uniquement (debug isolé)
ROS_LOCALHOST_ONLY=0

# ── DDS / FastRTPS ────────────────────────────────────────────────────────────
# Middleware DDS utilisé par ROS2
# Alternatives : rmw_cyclonedds_cpp (plus simple, moins configurable)
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ── Robot identity ────────────────────────────────────────────────────────────
ROBOT_NAME=mecarosmaster

# ── Frames TF ─────────────────────────────────────────────────────────────────
BASE_FRAME=base_link
ODOM_FRAME=odom
MAP_FRAME=map

# ── Build Docker ──────────────────────────────────────────────────────────────
# UID/GID de l'utilisateur hôte — évite les problèmes de droits sur les volumes
# À ajuster si votre utilisateur hôte n'est pas 1000:1000
# Commande : id -u && id -g
USER_ID=1000
GROUP_ID=1000
