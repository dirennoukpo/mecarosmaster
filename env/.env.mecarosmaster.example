# =============================================================================
# env/.env.mecarosmaster — Variables spécifiques au ROBOT PHYSIQUE
# YAHBOOM ROSMASTER / Raspberry Pi — Architecture arm64
#
# Ce fichier surcharge env/.env pour tout ce qui est propre à la machine robot.
# Ne pas versionner si contient des adresses IP ou ports sensibles.
# =============================================================================

# ── Port série YAHBOOM ERF (contrôleur moteurs / base roulante) ───────────────
# Vérifier avec : ls /dev/serial/by-id/ ou dmesg | grep tty
# Valeurs courantes : /dev/ttyUSB0  /dev/ttyAMA0  /dev/YB-ERF01-v3.0
SERIAL_PORT=/dev/YB-ERF01-v3.0
SERIAL_BAUDRATE=115200

# ── Caméra embarquée (optionnel — laisser vide si non utilisée) ──────────────
# Exemples : /dev/video0  /dev/video2
CAMERA_PORT=/dev/video0

# ── FastDDS — profil XML robot ────────────────────────────────────────────────
# Profil optimisé Pi : unicast, buffers réduits, heartbeat fréquent
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_base.xml

# ── Capteurs — activation/désactivation à chaud ──────────────────────────────
# true/false — contrôlé dans les launch files via ce paramètre
ENABLE_LIDAR=true
ENABLE_CAMERA=true
ENABLE_IMU=true

# ── Odométrie / EKF ───────────────────────────────────────────────────────────
# Fréquence de fusion EKF (Hz) — 30 Hz recommandé pour Pi 4
EKF_FREQUENCY=30

# ── Sim time ──────────────────────────────────────────────────────────────────
# false en production, true uniquement pour replay rosbag
USE_SIM_TIME=false

# ── Réseau — IP du robot sur le LAN (utilisée par la workstation pour DDS) ───
# À renseigner avec l'IP fixe du Pi sur votre réseau local
# Exemple : ROBOT_IP=192.168.1.100
ROBOT_IP=192.168.1.100
