# =============================================================================
# env/.env.workstation — Variables spécifiques à la WORKSTATION développeur
# Linux amd64 — SLAM, visualisation, debug, navigation
#
# Ce fichier surcharge env/.env pour tout ce qui est propre au poste dev.
# =============================================================================

# ── FastDDS — profil XML workstation ─────────────────────────────────────────
# Profil LAN : buffers larges pour PointCloud2 / RGBD / LaserScan
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/fastdds_workstation.xml

# ── IP du robot — peer DDS statique ──────────────────────────────────────────
# Adresse IP fixe du Raspberry Pi sur le LAN
# Doit correspondre à ROBOT_IP dans .env.mecarosmaster
ROS_MASTER_IP=192.168.1.100

# ── Display X11 — RViz2 / rqt ────────────────────────────────────────────────
# Récupérer la valeur sur l'hôte : echo $DISPLAY
# En local : :0 ou :1
# Via SSH : utiliser ssh -X et récupérer la valeur de $DISPLAY
DISPLAY=:0

# Variables Qt nécessaires pour RViz2 dans Docker
QT_X11_NO_MITSHM=1
LIBGL_ALWAYS_INDIRECT=0

# ── SLAM ──────────────────────────────────────────────────────────────────────
# Mode SLAM actif au démarrage
# Valeurs : rtabmap | cartographer | slam_toolbox
SLAM_MODE=rtabmap

# Capteur SLAM principal
# Valeurs : rgbd (RealSense D435) | lidar | lidar_rgbd
SLAM_SENSOR=rgbd

# ── Sim time ──────────────────────────────────────────────────────────────────
# true lors d'un replay rosbag (ros2 bag play)
# false en live avec le robot physique
USE_SIM_TIME=false

# ── Navigation Nav2 ───────────────────────────────────────────────────────────
# Activer la stack Nav2 complète au démarrage de la workstation
# true = démarre planner, controller, costmap, lifecycle manager
ENABLE_NAV2=false

# ── RealSense D435i ──────────────────────────────────────────────────────────
# Serial number de la caméra (optionnel — laisser vide pour auto-detect)
# Obtenir avec : rs-enumerate-devices | grep Serial
REALSENSE_SERIAL=

# ── Debug / développement ─────────────────────────────────────────────────────
# Niveau de log ROS2 : DEBUG | INFO | WARN | ERROR | FATAL
RCUTILS_LOGGING_SEVERITY_THRESHOLD=INFO

# Colorisation des logs ROS2 dans le terminal
RCUTILS_COLORIZED_OUTPUT=1
