<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     fastdds_base.xml — Profil FastDDS pour le ROBOT (mecarosmaster)
     Optimisé pour Raspberry Pi : unicast uniquement, limiter la bande passante
     ============================================================================= -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <transport_descriptors>
        <!-- UDP v4 — transport principal ROS2/DDS -->
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <!-- Buffers envoi/réception optimisés pour Pi -->
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>4194304</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="mecarosmaster_robot_participant" is_default_profile="true">
        <rtps>
            <name>mecarosmaster_robot</name>

            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>

            <!-- Découverte : limité au sous-réseau local -->
            <builtin>
                <discovery_config>
                    <discoveryProtocol>SIMPLE</discoveryProtocol>
                    <use_SIMPLE_EndpointDiscoveryProtocol>true</use_SIMPLE_EndpointDiscoveryProtocol>
                    <m_simpleEDP>
                        <use_Publication_WriterANDSubscription_Reader>true</use_Publication_WriterANDSubscription_Reader>
                        <use_Publication_ReaderANDSubscription_Writer>true</use_Publication_ReaderANDSubscription_Writer>
                    </m_simpleEDP>
                    <!-- Heartbeat plus fréquent pour réseaux embarqués -->
                    <leaseDuration>
                        <sec>20</sec>
                        <nanosec>0</nanosec>
                    </leaseDuration>
                    <leaseAnnouncement>
                        <sec>3</sec>
                        <nanosec>0</nanosec>
                    </leaseAnnouncement>
                </discovery_config>
            </builtin>

            <sendSocketBufferSize>1048576</sendSocketBufferSize>
            <listenSocketBufferSize>4194304</listenSocketBufferSize>
        </rtps>
    </participant>

</profiles>
