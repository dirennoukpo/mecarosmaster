<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     fastdds_workstation.xml — Profil FastDDS pour la WORKSTATION
     Compatible ROS2 / FastDDS
     ============================================================================= -->

<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <!-- =========================
         TRANSPORT UDPv4
         ========================= -->
    <transport_descriptors>

        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>

            <!-- Buffers plus grands pour LiDAR / caméra -->
            <sendBufferSize>4194304</sendBufferSize>
            <receiveBufferSize>16777216</receiveBufferSize>

            <!-- Publication non bloquante -->
            <non_blocking_send>true</non_blocking_send>

        </transport_descriptor>

    </transport_descriptors>

    <!-- =========================
         PARTICIPANT ROS2
         ========================= -->
    <participant
        profile_name="mecarosmaster_workstation_participant"
        is_default_profile="true">

        <rtps>

            <!-- Nom DDS -->
            <name>mecarosmaster_workstation</name>

            <!-- Désactive transports builtin -->
            <useBuiltinTransports>false</useBuiltinTransports>

            <!-- Utilise uniquement UDPv4 -->
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>

            <!-- =========================
                 DISCOVERY
                 ========================= -->
            <builtin>

                <discovery_config>

                    <!-- Discovery ROS2 standard -->
                    <discoveryProtocol>SIMPLE</discoveryProtocol>

                    <!-- Endpoint discovery -->
                    <m_simpleEDP>

                        <use_Publication_WriterANDSubscription_Reader>
                            true
                        </use_Publication_WriterANDSubscription_Reader>

                        <use_Publication_ReaderANDSubscription_Writer>
                            true
                        </use_Publication_ReaderANDSubscription_Writer>

                    </m_simpleEDP>

                    <!-- Timing discovery -->
                    <leaseDuration>
                        <sec>30</sec>
                        <nanosec>0</nanosec>
                    </leaseDuration>

                    <leaseAnnouncement>
                        <sec>5</sec>
                        <nanosec>0</nanosec>
                    </leaseAnnouncement>

                </discovery_config>

            </builtin>

            <!-- Buffers sockets -->
            <sendSocketBufferSize>4194304</sendSocketBufferSize>
            <listenSocketBufferSize>16777216</listenSocketBufferSize>

        </rtps>

    </participant>

</profiles>